{
  "name": "skim-browser",
  "version": "0.1.0",
  "description": "Give AI agents a browser that sends ~330 tokens per page instead of ~34,000. Compact page digests, actions by id, diffs, tabs, plans.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyouki-ai/skim.git"
  },
  "homepage": "https://github.com/kyouki-ai/skim#readme",
  "bin": {
    "skim": "src/cli.mjs",
    "skim-server": "src/server.mjs",
    "skim-mcp": "mcp/server.mjs",
    "skim-agentic-mcp": "mcp/agentic.mjs"
  },
  "main": "src/server.mjs",
  "files": [
    "src",
    "mcp",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "cli": "node src/cli.mjs"
  },
  "dependencies": {
    "playwright": "^1.65.1"
  },
  "keywords": [
    "ai",
    "agents",
    "browser",
    "playwright",
    "llm",
    "tokens",
    "automation",
    "mcp"
  ],
